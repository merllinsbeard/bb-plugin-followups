#!/usr/bin/env node
// A stand-in for the `claude` CLI, put first on PATH by the tests (see helpers.mjs).
// It appends one JSON line per call to $FAKE_CLAUDE_DIR/calls.jsonl (argv, stdin, cwd and
// the Bash timeout env), then answers like `claude -p --output-format json` from
// $FAKE_CLAUDE_DIR/fixtures.json, read fresh on every call:
//
//   { "suggest": Step | Step[], "draft": Step | Step[], "card": Step | Step[] }
//   Step = { output?, delayMs?, gate?, fail?: "is_error" | "exit" | "garbage", usage?, denials? }
//
// The call's kind comes from its --json-schema (candidates -> suggest, message -> draft,
// task -> card). With an array, the nth call of a kind gets the nth step (the last repeats).
// `gate` names a file: the answer waits until the test creates it.
import { appendFileSync, existsSync, readFileSync } from "node:fs";
import { join } from "node:path";

const dir = process.env.FAKE_CLAUDE_DIR;
if (!dir) {
  process.stderr.write("FAKE_CLAUDE_DIR is not set\n");
  process.exit(2);
}
const argv = process.argv.slice(2);
const flag = (name) => {
  const at = argv.indexOf(name);
  return at === -1 ? null : argv[at + 1];
};
const properties = Object.keys(JSON.parse(flag("--json-schema") ?? "{}").properties ?? {});
const kind = properties.includes("candidates")
  ? "suggest"
  : properties.includes("message")
    ? "draft"
    : properties.includes("task")
      ? "card"
      : "unknown";

let stdin = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (chunk) => (stdin += chunk));
process.stdin.on("end", main);

async function main() {
  const log = join(dir, "calls.jsonl");
  const earlier = existsSync(log)
    ? readFileSync(log, "utf8").split("\n").filter(Boolean).map((line) => JSON.parse(line)).filter((call) => call.kind === kind).length
    : 0;
  appendFileSync(
    log,
    JSON.stringify({
      kind,
      argv,
      stdin,
      cwd: process.cwd(),
      bashTimeoutMs: process.env.BASH_MAX_TIMEOUT_MS ?? null,
      pid: process.pid,
      at: Date.now(),
    }) + "\n",
  );
  const fixtures = JSON.parse(readFileSync(join(dir, "fixtures.json"), "utf8"));
  const steps = [fixtures[kind] ?? {}].flat();
  const step = steps[Math.min(earlier, steps.length - 1)];
  if (step.delayMs) await new Promise((resolve) => setTimeout(resolve, step.delayMs));
  if (step.gate) while (!existsSync(step.gate)) await new Promise((resolve) => setTimeout(resolve, 20));
  if (step.fail === "exit") {
    process.stderr.write("fake claude: failed on purpose\n");
    process.exit(1);
  }
  if (step.fail === "garbage") {
    process.stdout.write("this is not json");
    return;
  }
  process.stdout.write(
    JSON.stringify({
      type: "result",
      subtype: step.fail === "is_error" ? "error_during_execution" : "success",
      is_error: step.fail === "is_error",
      result: step.fail === "is_error" ? "fake claude: model error on purpose" : "",
      num_turns: 2,
      structured_output: step.output ?? null,
      usage: step.usage ?? {
        input_tokens: 900,
        cache_creation_input_tokens: 100,
        cache_read_input_tokens: 2000,
        output_tokens: 300,
        output_tokens_details: { thinking_tokens: 200 },
      },
      permission_denials: (step.denials ?? []).map((tool_name) => ({ tool_name, tool_use_id: "toolu_fake", tool_input: {} })),
    }),
  );
}
